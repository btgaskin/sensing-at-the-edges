{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sensing Edges Metrics Row (one per generation)",
  "type": "object",
  "required": ["generation", "best_fitness", "coverage"],
  "properties": {
    "generation": { "type": "integer", "minimum": 0 },
    "population": { "type": "integer", "minimum": 0 },
    "elapsed_s": { "type": "number" },
    "best_fitness": { "type": "number" },
    "best_generation_fitness": { "type": "number" },
    "mean_fitness": { "type": "number" },
    "qd_score": { "type": "number" },
    "coverage": { "type": "number", "minimum": 0, "maximum": 1 },
    "threshold_mean": { "type": "number" },
    "n_occupied": { "type": "integer", "minimum": 0 },
    "new_cells": { "type": "integer", "minimum": 0 },
    "improved_cells": { "type": "integer", "minimum": 0 },
    "invalid_descriptor_count": { "type": "integer", "minimum": 0 },
    "mean_fall_count": { "type": "number", "minimum": 0 },
    "null_rate": { "type": "number", "minimum": 0, "maximum": 1 },
    "emitter_restarts": { "type": "array", "items": { "type": "integer" } },
    "total_restarts": { "type": "integer", "minimum": 0 },
    "mean_sigma": { "type": "number", "minimum": 0 },
    "improvement_rate": { "type": "number", "minimum": 0, "maximum": 1 },
    "candidates_per_s": { "type": "number", "minimum": 0 },
    "episodes_per_s": { "type": "number", "minimum": 0 },
    "ask_s": { "type": "number", "minimum": 0 },
    "eval_s": { "type": "number", "minimum": 0 },
    "archive_s": { "type": "number", "minimum": 0 },
    "tell_s": { "type": "number", "minimum": 0 },
    "checkpoint_s": { "type": "number", "minimum": 0 },
    "chunk_count": { "type": "integer", "minimum": 0 },
    "mean_chunk_size": { "type": "number", "minimum": 0 },
    "max_chunk_size": { "type": "integer", "minimum": 0 },
    "bucket_chunk_counts": { "type": "object" },
    "checkpoint_path": { "type": ["string", "null"] }
  }
}
